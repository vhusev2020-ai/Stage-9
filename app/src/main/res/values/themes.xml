<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VEbalist" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#0F766E</item>
        <item name="colorPrimaryVariant">#115E59</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0F766E</item>
    </style>

    <style name="VEbalistStepTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VEbalistStepHelp" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">#64748B</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="VEbalistFieldLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:textColor">#475569</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VEbalistSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/editTextBackground</item>
    </style>

    <style name="VEbalistPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="VEbalistSecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#0F766E</item>
        <item name="strokeColor">#0F766E</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="VEbalistErrorButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#9A3412</item>
        <item name="strokeColor">#C2410C</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
