<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VEbalist"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="Step 1 of 4 — Connect VEbalist"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Connect"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect securely, then load your saved eBay policies."
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/backendUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Secure service address"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/backendApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="App access key"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/saveBackendButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connect" />
            <Button
                android:id="@+id/loadEbaySetupButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Load eBay Setup" />
        </LinearLayout>

        <Spinner android:id="@+id/paymentSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/returnSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/fulfillmentSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/locationSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:text="2. Import"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the listing batch created from your ChatGPT pictures and details."
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose ChatGPT Batch ZIP" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/newListingButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="New Listing" />
            <Button android:id="@+id/addPicturesButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add Pictures" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:text="3. Review"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap a listing to select it. Press and hold to edit it."
            android:paddingBottom="6dp" />

        <Button android:id="@+id/applyDefaultsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply My eBay Policies" />
        <Button android:id="@+id/validateAspectsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check All Listing Details" />
        <Button android:id="@+id/fillMissingButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fix Missing Details" />
        <Button android:id="@+id/testListingButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Final eBay Check" />

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:choiceMode="multipleChoice" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:text="4. Publish"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only ready, selected listings will be sent to eBay."
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/publishReadyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Publish Selected Listings" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/retryFailedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="Retry Failed" />
            <Button android:id="@+id/historyButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="History" />
        </LinearLayout>

        <Button
            android:id="@+id/exportErrorLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Error Log" />

        <Button
            android:id="@+id/exportBatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Corrected Batch ZIP" />
    </LinearLayout>
</ScrollView>
